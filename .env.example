# ScreenCraft 环境变量模板
# 使用：工程脚手架建好后，将本文件拆为 backend/.env 与 frontend/.env（按分隔注释归位），
#      并将真实值填入；.env 必须加入 .gitignore，禁止提交任何真实密钥。

# ================= backend/.env =================

# 服务端口
PORT=3000

# MongoDB 连接（系统数据存储：users/projects/screens/templates/api_configs/assets/kb_docs）
MONGO_URI=mongodb://localhost:27017/screencraft

# JWT 签发密钥（随机长字符串；泄露须立即更换）
JWT_SECRET=change-me-to-a-random-long-string

# 腾讯位置服务 WebServiceAPI key（天气代理专用）
# 仅后端使用：/weather 接口代理时注入，严禁下发浏览器、严禁写入文档/前端代码/提交记录
WEATHER_KEY=

# 业务数据库连接（SQL 生成类数据源；v1 默认 MySQL；必须使用只读账号）
BUSINESS_DB_DSN=mysql://readonly:change-me@localhost:3306/biz

# 外部登记类 API 代理的域名白名单（逗号分隔；SSRF 防护）
PROXY_HOST_WHITELIST=apis.map.qq.com

# 上传文件存储目录（相对 backend 运行目录；图片/视频，单文件 ≤200MB）
UPLOAD_DIR=./uploads

# 大模型 API（AI 智能设计；管理员亦可在后台「AI 设置」配置并覆盖）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TEXT_MODEL=deepseek-v4-flash
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
# 整屏范围默认关闭；仅在 200 组件性能验收通过的环境中与前端开关同时启用
AI_SCREEN_SCOPE_ENABLED=false
# v0.3 兼容接口可继续读取，新的 AI 智能设计功能不使用
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=

# 种子管理员（首次登录强制改密；生产部署后建议改掉默认值）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ScreenCraft@2026

# ================= frontend/.env =================

# 后端 API 基础路径（开发环境走 Vite 代理）
VITE_API_BASE=/api/v1
# 与后端 AI_SCREEN_SCOPE_ENABLED 保持一致
VITE_AI_SCREEN_SCOPE_ENABLED=false
