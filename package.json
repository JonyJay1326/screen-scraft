{
  "name": "screencraft",
  "private": true,
  "version": "0.3.1",
  "description": "ScreenCraft 大屏配置系统",
  "scripts": {
    "dev": "pnpm --filter @screencraft/shared build && pnpm -r --parallel --filter @screencraft/shared --filter frontend --filter backend dev",
    "build": "pnpm -r --filter @screencraft/shared --filter frontend --filter backend build",
    "test": "pnpm -r test",
    "seed": "pnpm --filter backend seed",
    "mongo:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-mongo.ps1"
  }
}
